#include <stdio.h>
int main(){
int a[100],n,i,p,v,ch;
scanf("%d",&n);
for(i=0;i<n;i++)scanf("%d",&a[i]);
printf("1.Display 2.Insert 3.Delete 4.Search 5.Update\n");
scanf("%d",&ch);
switch(ch){
case 1: for(i=0;i<n;i++)printf("%d ",a[i]);break;
case 2:
scanf("%d%d",&p,&v);
if(p<1||p>n+1||n>=100)break;
for(i=n;i>=p;i--)a[i]=a[i-1];
a[p-1]=v;n++;
for(i=0;i<n;i++)printf("%d ",a[i]);break;
case 3:
scanf("%d",&p);
if(p<1||p>n)break;
for(i=p-1;i<n-1;i++)a[i]=a[i+1];
for(i=0;i<--n;i++)printf("%d ",a[i]);break;
case 4:
scanf("%d",&v);
for(i=0;i<n&&a[i]!=v;i++);
if(i<n)printf("Found at position %d",i+1);
else printf("Not found");break;
case 5:
scanf("%d%d",&p,&v);
if(p<1||p>n)break;
a[p-1]=v;
for(i=0;i<n;i++)printf("%d ",a[i]);break;
default:printf("Invalid choice");
}
return 0;
}